import os
import shutil
from datetime import datetime

def sort_files_by_type_and_year(source_folder):
    # Проверка на существованиеисходной папки
    if not os.path.exists(source_folder):
        print(f"Папка {source_folder} не существует!")
        return
    
    # Рекурсивный обход всех папок и подпапок
    for root, dirs, files in os.walk(source_folder, topdown=False):
        for filename in files:
            file_path = os.path.join(root, filename)
            
            # Получение расширение файла
            file_ext = os.path.splitext(filename)[1].lower()
            if not file_ext:  
                file_ext = "no_extension"
            else:
                file_ext = file_ext[1:]  
            
            # Получение времен создания файла
            creation_time = os.path.getctime(file_path)
            year = datetime.fromtimestamp(creation_time).year
            
            # Создание пути для папок по году и расширению
            year_folder = os.path.join(source_folder, str(year))
            dest_folder = os.path.join(year_folder, file_ext)
            
            # Создание папки, если она не существует
            os.makedirs(dest_folder, exist_ok=True)
            
            # Перемещение файла
            try:
                shutil.move(file_path, os.path.join(dest_folder, filename))
                print(f"Файл {filename} перемещен в {dest_folder}")
            except Exception as e:
                print(f"Ошибка при перемещении файла {filename}: {e}")
        
        # Удаление пустых папок после перемещения файлов
        try:
            if root != source_folder and not os.listdir(root):
                os.rmdir(root)
                print(f"Удалена пустая папка: {root}")
        except Exception as e:
            print(f"Не удалось удалить папку {root}: {e}")

if __name__ == "__main__":
    # Указать путь к папке, которую нужно отсортировать
    folder_to_sort = "Путь, где нужна сортировка"  
    
    sort_files_by_type_and_year(folder_to_sort)
    print("Сортировка завершена!")
